    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.547",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@remotion/tailwind-v4": "^4.0.547",
    "@tailwindcss/vite": "^4.3.5",
